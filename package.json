{
  "name": "w3booster-match-vision",
  "version": "0.1.0",
  "description": "W3Booster's open-source live match visualization application.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 8082",
    "start-ssl": "ng serve --port 8082 --ssl --ssl-key cert/server.key --ssl-cert cert/server.crt",
    "build": "ng build --configuration production",
    "test": "vitest run",
    "check": "node --test scripts/*.node-test.mjs && npm test && npm run build",
    "app:fork": "node scripts/fork.mjs",
    "w3booster:sync": "w3booster-settings --output \"src/app/core/w3booster-app.generated.ts\"",
    "w3booster:check": "w3booster-settings --output \"src/app/core/w3booster-app.generated.ts\" --check",
    "sdk:link-local": "node scripts/link-local-sdk.mjs",
    "test:overlay:browser": "node scripts/overlay-sdk3.browser-test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@w3booster/sdk": "^2.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "playwright": "1.62.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/W3Booster/app-match-vision.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "w3booster": {
    "clientId": "app_7bd7c42015297f608f1e5436",
    "settingsOutput": "src/app/core/w3booster-app.generated.ts"
  }
}
